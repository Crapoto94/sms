{
  "openapi": "3.0.3",
  "info": {
    "title": "Passerelle SMS — API d'envoi",
    "version": "1.0.0",
    "description": "API permettant à une application web de demander l'envoi d'un SMS. Le SMS est mis en file d'attente puis envoyé par la passerelle (le téléphone) au prochain cycle de synchronisation.\n\nL'authentification se fait par **Bearer token** : une clé API de type **Web** (créée dans la console d'administration)."
  },
  "tags": [
    { "name": "Messages", "description": "Envoi de SMS et pièces jointes" },
    { "name": "Système", "description": "Vérification de disponibilité" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clé API de type \"web\"."
      }
    },
    "schemas": {
      "SendMessageRequest": {
        "type": "object",
        "required": ["recipient", "message"],
        "properties": {
          "recipient": {
            "type": "string",
            "description": "Numéro de téléphone, au format international (avec ou sans +).",
            "pattern": "^\\+?[0-9]{4,15}$",
            "example": "+33612345678"
          },
          "message": {
            "type": "string",
            "description": "Contenu du SMS (jusqu'à 1000 caractères ; au-delà de 160, le message est envoyé en plusieurs segments).",
            "maxLength": 1000,
            "example": "Votre colis sera livré demain."
          },
          "attachmentId": {
            "type": "integer",
            "description": "Identifiant retourné par l'upload d'une pièce jointe. Le serveur ajoute automatiquement au SMS un lien public suivi.",
            "example": 7
          }
        }
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 7 },
          "name": { "type": "string", "example": "brochure.pdf" },
          "mimeType": { "type": "string", "example": "application/pdf" },
          "size": { "type": "integer", "example": 24576 },
          "url": { "type": "string", "format": "uri", "description": "Lien public non authentifié. Chaque ouverture est comptabilisée." }
        }
      },
      "AttachmentUploadResponse": {
        "allOf": [
          { "$ref": "#/components/schemas/Attachment" }
        ]
      },
      "MessageCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Identifiant du message en base.",
            "example": 42
          },
          "recipient": {
            "type": "string",
            "example": "+33612345678"
          },
          "message": {
            "type": "string",
            "example": "Votre colis sera livré demain."
          },
          "status": {
            "type": "string",
            "enum": ["pending"],
            "description": "Statut initial : en attente d'envoi."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "attachment": {
            "allOf": [ { "$ref": "#/components/schemas/Attachment" } ],
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Description de l'erreur."
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/attachments": {
      "post": {
        "tags": ["Messages"],
        "summary": "Uploader une pièce jointe",
        "description": "Upload authentifié d'un fichier. Utilisez l'identifiant retourné dans `attachmentId` lors de la création du SMS.",
        "operationId": "uploadAttachment",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pièce jointe uploadée.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AttachmentUploadResponse" } } }
          },
          "400": { "description": "Fichier manquant ou upload invalide.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Clé API manquante ou invalide.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "413": { "description": "Fichier supérieur à 10 Mo.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/api/v1/attachments/{token}": {
      "get": {
        "tags": ["Messages"],
        "summary": "Ouvrir une pièce jointe",
        "description": "Endpoint public sans authentification. L'ouverture est enregistrée puis le fichier est retourné.",
        "operationId": "openAttachment",
        "security": [],
        "parameters": [
          { "name": "token", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Fichier de la pièce jointe." },
          "404": { "description": "Pièce jointe introuvable." }
        }
      }
    },
    "/api/v1/messages": {
      "post": {
        "tags": ["Messages"],
        "summary": "Envoyer un SMS",
        "description": "Crée un SMS qui sera envoyé par la passerelle au prochain cycle de synchronisation (en file d'attente, un SMS toutes les 5 à 10 secondes).\n\nNécessite une clé API de type **web**.",
        "operationId": "sendMessage",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendMessageRequest"
              },
              "example": {
                "recipient": "+33612345678",
                "message": "Votre colis sera livré demain."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Message créé et mis en file d'attente.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageCreated"
                }
              }
            }
          },
          "400": {
            "description": "Numéro invalide, message vide ou message trop long (plus de 1000 caractères).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Clé API manquante ou invalide.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Clé API révoquée, expirée ou type de clé inadapté (la clé doit être de type \"web\").",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Système"],
        "summary": "Vérifier que l'API est disponible",
        "security": [],
        "responses": {
          "200": {
            "description": "API disponible.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
